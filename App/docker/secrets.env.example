# Mountain Hut (Team 09) - template of secrets.env for the Docker release.
# Copy it to App/docker/secrets.env (git ignores that file), fill in the values, and zip it as
# Team09-secrets.zip for the Elaborati section of the course portal. Never commit the filled file.
# Write values without quotes.

# Random values, e.g. from: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=

# Emails: every email appears in the Mailpit inbox (http://localhost:8025). The lines below make Mailpit
# also deliver each email to its real address through the project Gmail account.
# Delete them to keep the emails in Mailpit only.
MAIL_FROM=Mountain Hut <mountainhut.09@gmail.com>
MP_SMTP_RELAY_HOST=smtp.gmail.com
MP_SMTP_RELAY_PORT=465
MP_SMTP_RELAY_TLS=true
MP_SMTP_RELAY_AUTH=plain
MP_SMTP_RELAY_USERNAME=mountainhut.09@gmail.com
# Gmail app password (16 letters, no spaces), not the account password
MP_SMTP_RELAY_PASSWORD=
MP_SMTP_RELAY_ALL=true
